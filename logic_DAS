# Model name
MODEL_NAME = "meta-llama/Llama-3.1-8B-Instruct"

# Set random seeds
set_seed(42)
random.seed(42)
np.random.seed(42)
torch.manual_seed(42)

# Device
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Load model
tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
if tokenizer.pad_token is None:
    tokenizer.pad_token = tokenizer.eos_token
model = AutoModelForCausalLM.from_pretrained(
    MODEL_NAME,
    torch_dtype=torch.float16,
    device_map="auto"
)
model.to(device)
model.eval()

###############################################################################
# DEFINE LOGICAL TASK (XOR EXAMPLE), DATA GENERATION, AND DATASET PREP
###############################################################################

colors = ["yellow", "blue", "green"]
shapes = ["circle", "triangle", "rectangle"]
color_abbr = {"yellow": "yel", "blue": "blu", "green": "grn"}
shape_abbr = {"circle": "cir", "triangle": "tri", "rectangle": "rec"}

def rule_eval(color, shape):
    return (color == "yellow") ^ (shape == "circle")

def causal_model_a(color, shape):
    return (color == "yellow") ^ (shape == "circle")

def causal_model_b(color, shape):
    c_yel = (color == "yellow")
    s_cir = (shape == "circle")
    return (c_yel or s_cir) and not (c_yel and s_cir)

def build_prompt_and_labels(objects):
    intro = (
        "We will use 'yel' for yellow, 'blu' for blue, 'grn' for green.\n"
        "We will use 'cir' for circle, 'tri' for triangle, 'rec' for rectangle.\n\n"
    )
    prompt_text = (
        "Learn the secret rule to label the objects correctly. "
        "If an object follows the rule, it should be labeled 'True'. "
        "Otherwise, 'False'. Be concise and always follow the arrow '->' "
        "with an object's label.\n\n"
        "Label the following objects:\n"
    )
    obj_lines = []
    lab_lines = []
    for color, shape in objects:
        obj_str = f"- {color_abbr[color]} {shape_abbr[shape]}"
        label = "True" if rule_eval(color, shape) else "False"
        obj_lines.append(obj_str)
        lab_lines.append(f"{obj_str} -> {label}")
    full_prompt = intro + prompt_text + "\n".join(obj_lines) + "\n"
    full_target = "\n".join(lab_lines) + "\n"
    return full_prompt, full_target

def generate_example(num_objects=5):
    objs = []
    for _ in range(num_objects):
        c = random.choice(colors)
        s = random.choice(shapes)
        objs.append((c, s))
    prompt, target = build_prompt_and_labels(objs)
    enc_prompt = tokenizer(prompt, return_tensors="pt")
    enc_target = tokenizer(target, return_tensors="pt")
    input_ids = torch.cat([enc_prompt["input_ids"], enc_target["input_ids"]], dim=1).squeeze()
    attention_mask = torch.ones_like(input_ids)
    labels = input_ids.clone()
    labels[: enc_prompt["input_ids"].shape[1]] = -100
    return {
        "input_ids": input_ids,
        "attention_mask": attention_mask,
        "labels": labels,
    }

def pad_seq(seq, max_len, pad_token_id, label_pad=-100):
    need = max_len - seq.size(0)
    if need <= 0:
        return seq
    if label_pad == -100:
        padvec = torch.full((need,), pad_token_id, dtype=seq.dtype)
        return torch.cat([seq, padvec], dim=0)
    else:
        padvec = torch.full((need,), label_pad, dtype=seq.dtype)
        return torch.cat([seq, padvec], dim=0)

num_samples = 20000
data_list = []
for _ in tqdm(range(num_samples), desc="Generating dataset"):
    ex = generate_example()
    data_list.append(ex)

max_len = max(d["input_ids"].size(0) for d in data_list)
for d in data_list:
    d["input_ids"] = pad_seq(d["input_ids"], max_len, tokenizer.pad_token_id)
    d["attention_mask"] = pad_seq(d["attention_mask"], max_len, 0)
    d["labels"] = pad_seq(d["labels"], max_len, -100, label_pad=-100)

dataset = Dataset.from_dict({
    "input_ids": [d["input_ids"].tolist() for d in data_list],
    "attention_mask": [d["attention_mask"].tolist() for d in data_list],
    "labels": [d["labels"].tolist() for d in data_list]
})
split_data = dataset.train_test_split(test_size=0.1, seed=42)
train_data = split_data["train"]
val_data = split_data["test"]
train_data.set_format(type="torch", columns=["input_ids", "attention_mask", "labels"])
val_data.set_format(type="torch", columns=["input_ids", "attention_mask", "labels"])
batch_size = 8
train_loader = DataLoader(train_data, batch_size=batch_size, shuffle=True)
val_loader = DataLoader(val_data, batch_size=batch_size, shuffle=False)

###############################################################################
# QUICK EVAL OF MODEL
###############################################################################
model.eval()
total_toks = 0
correct_toks = 0
with torch.no_grad():
    for batch in tqdm(val_loader, desc="Evaluating base model"):
        in_ids = batch["input_ids"].to(device)
        attn = batch["attention_mask"].to(device)
        lbls = batch["labels"].to(device)
