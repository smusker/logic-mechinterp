with torch.no_grad():
    for batch in tqdm(intervention_loader_b, desc="Evaluating IIA (Model B)"):
        # Move data to device
        input_ids_base = batch['input_ids_base'].to(device)
        attention_mask_base = batch['attention_mask_base'].to(device)
