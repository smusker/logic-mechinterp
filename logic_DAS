# Function to generate intervention data
def generate_intervention_data(num_examples, causal_model_func):
    intervention_data = []
    for _ in tqdm(range(num_examples), desc="Generating intervention data"):
        # Base example
        color_base = random.choice(colors)
        shape_base = random.choice(shapes)
        label_base = 'True' if causal_model_func(color_base, shape_base) else 'False'

        # Source example
        while True:
            color_source = random.choice(colors)
            shape_source = random.choice(shapes)
            if color_source != color_base or shape_source != shape_base:
                break
        label_source = 'True' if causal_model_func(color_source, shape_source) else 'False'

        # Ensure consistent object formatting
        def create_object_description(color, shape):
            return f"- {color_abbr[color]} {shape_abbr[shape]}"

        obj_base = create_object_description(color_base, shape_base)
        obj_source = create_object_description(color_source, shape_source)

        # Create prompts and targets
        intro = (
            "We will use 'yel' for yellow, 'blu' for blue, 'grn' for green.\n"
            "We will use 'cir' for circle, 'tri' for triangle, 'rec' for rectangle.\n\n"
        )
        prompt = (
            "Learn the secret rule to label the objects correctly. "
            "If an object follows the rule, it should be labeled 'True'. Otherwise, 'False'. "
            "Be concise and always follow the arrow '->' with an object's label.\n\n"
            "Label the following object:\n"
        )

        full_prompt_base = intro + prompt + obj_base + "\n"
        full_target_base = f"{obj_base} -> {label_base}\n"

        full_prompt_source = intro + prompt + obj_base + "\n"
        full_target_source = f"{obj_base} -> {label_source}\n"

        # Tokenize base and source
        inputs_base = tokenizer(full_prompt_base, return_tensors='pt')
        targets_base = tokenizer(full_target_base, return_tensors='pt')

        inputs_source = tokenizer(full_prompt_source, return_tensors='pt')
        targets_source = tokenizer(full_target_source, return_tensors='pt')

        # Combine inputs and labels
        input_ids_base = torch.cat([inputs_base['input_ids'], targets_base['input_ids']], dim=1)
        attention_mask_base = torch.ones_like(input_ids_base)
        labels_base = input_ids_base.clone()
        labels_base[:, :inputs_base['input_ids'].shape[1]] = -100  # Mask out the prompt

        input_ids_source = torch.cat([inputs_source['input_ids'], targets_source['input_ids']], dim=1)
        attention_mask_source = torch.ones_like(input_ids_source)
        labels_source = input_ids_source.clone()
        labels_source[:, :inputs_source['input_ids'].shape[1]] = -100  # Mask out the prompt

        # Record token positions for variables
        def get_variable_positions(input_ids):
            color_tokens = [tokenizer.encode(abbr, add_special_tokens=False)[0] for abbr in color_abbr.values()]
            shape_tokens = [tokenizer.encode(abbr, add_special_tokens=False)[0] for abbr in shape_abbr.values()]
            positions = []
            for i, id in enumerate(input_ids.squeeze().tolist()):
                if id in color_tokens + shape_tokens:
                    positions.append(i)
            return positions

        positions_base = get_variable_positions(inputs_base['input_ids'])
        positions_source = get_variable_positions(inputs_source['input_ids'])
        # Ensure positions are aligned
        if positions_base != positions_source:
            continue  # Skip this example if positions don't align

        intervention_data.append({
            'input_ids_base': input_ids_base.squeeze(),
            'attention_mask_base': attention_mask_base.squeeze(),
            'labels_base': labels_base.squeeze(),
            'input_ids_source': input_ids_source.squeeze(),
            'attention_mask_source': attention_mask_source.squeeze(),
            'labels_source': labels_source.squeeze(),
            'positions': positions_base
        })
    return intervention_data

# Generate intervention data for both causal models
intervention_examples = 10000  # Adjust as needed

# For Causal Model A
intervention_data_a = generate_intervention_data(intervention_examples, causal_model_a)

# For Causal Model B
intervention_data_b = generate_intervention_data(intervention_examples, causal_model_b)

# Function to prepare intervention data
def prepare_intervention_data(intervention_data):
    # Ensure sequences are of the same length
    max_length_base = max(len(d['input_ids_base']) for d in intervention_data)
    max_length_source = max(len(d['input_ids_source']) for d in intervention_data)
    max_length = max(max_length_base, max_length_source)

    # Pad intervention data
    for d in intervention_data:
        d['input_ids_base'] = pad_sequence(d['input_ids_base'], max_length)
        d['attention_mask_base'] = pad_attention(d['attention_mask_base'], max_length)
        d['labels_base'] = pad_labels(d['labels_base'], max_length)
        d['input_ids_source'] = pad_sequence(d['input_ids_source'], max_length)
        d['attention_mask_source'] = pad_attention(d['attention_mask_source'], max_length)
        d['labels_source'] = pad_labels(d['labels_source'], max_length)
        d['positions'] = d['positions']  # Keep positions as is

    # Create intervention Dataset and DataLoader
    intervention_dataset = Dataset.from_dict({
        'input_ids_base': [d['input_ids_base'].tolist() for d in intervention_data],
        'attention_mask_base': [d['attention_mask_base'].tolist() for d in intervention_data],
        'labels_base': [d['labels_base'].tolist() for d in intervention_data],
        'input_ids_source': [d['input_ids_source'].tolist() for d in intervention_data],
        'attention_mask_source': [d['attention_mask_source'].tolist() for d in intervention_data],
        'labels_source': [d['labels_source'].tolist() for d in intervention_data],
        'positions': [d['positions'] for d in intervention_data]
    })

    intervention_dataset.set_format(type='torch', columns=[
        'input_ids_base', 'attention_mask_base', 'labels_base',
        'input_ids_source', 'attention_mask_source', 'labels_source',
        'positions'
    ])

    intervention_loader = DataLoader(intervention_dataset, batch_size=batch_size)
    return intervention_loader

# Prepare intervention data loaders
intervention_loader_a = prepare_intervention_data(intervention_data_a)
intervention_loader_b = prepare_intervention_data(intervention_data_b)

# Training Boundless DAS on intervention data for Causal Model A
intervention_layers = [0, 5, 10, 15, 20, 25, 30]  # Adjust layers to align with Alpaca

# Initialize separate optimizer and scheduler for Boundless DAS training
subspace_proj_a = BoundlessRotatedSpaceIntervention(embed_dim=model.config.hidden_size)
subspace_proj_a.to(device)
optimizer_a = torch.optim.Adam([
    {'params': subspace_proj_a.rotate_layer.parameters()},
    {'params': subspace_proj_a.intervention_boundaries, 'lr': 1e-2}
], lr=1e-3)
total_steps = len(intervention_loader_a) * epochs
scheduler_a = torch.optim.lr_scheduler.LinearLR(optimizer_a, total_iters=total_steps)

# Temperature schedule for boundary masks
temperature_start = 50.0
temperature_end = 0.1
temperature_schedule = torch.linspace(temperature_start, temperature_end, total_steps)

print("\nTraining Boundless DAS for Causal Model A...")
step = 0
for epoch in range(epochs):
    subspace_proj_a.train()
    pbar = tqdm(intervention_loader_a, desc=f"Intervention Epoch {epoch+1}/{epochs} (Model A)")
    for batch in pbar:
        optimizer_a.zero_grad()

        # Move data to device
        input_ids_base = batch['input_ids_base'].to(device)
        attention_mask_base = batch['attention_mask_base'].to(device)
        labels_source = batch['labels_source'].to(device)
        input_ids_source = batch['input_ids_source'].to(device)
        attention_mask_source = batch['attention_mask_source'].to(device)
        positions = batch['positions']

        # Forward pass for base and source
        with torch.no_grad():
            outputs_base = model(input_ids_base, attention_mask=attention_mask_base, output_hidden_states=True)
            outputs_source = model(input_ids_source, attention_mask=attention_mask_source, output_hidden_states=True)

        # For each intervention layer
        hidden_states_base = outputs_base.hidden_states
        hidden_states_source = outputs_source.hidden_states

        # Initialize mixed_hidden_states with base
        mixed_hidden_states = list(hidden_states_base)

        for layer in intervention_layers:
            # Apply Boundless DAS intervention at specific token positions
            h_base = hidden_states_base[layer]
            h_source = hidden_states_source[layer]
            mixed_h = h_base.clone()
            for idx in range(h_base.size(0)):  # Batch size
                pos = positions[idx]
                for p in pos:
                    mixed_h[idx, p, :] = subspace_proj_a(h_base[idx, p, :], h_source[idx, p, :].detach())
            mixed_hidden_states[layer] = mixed_h

        # Continue forward pass from the first intervention layer
        hidden_states = mixed_hidden_states[intervention_layers[0]]
        for idx in range(intervention_layers[0] + 1, len(hidden_states_base)):
            if idx in intervention_layers:
                hidden_states = mixed_hidden_states[idx]
            else:
                hidden_states = model.transformer.h[idx](hidden_states)[0]

        logits = model.lm_head(hidden_states)

        # Compute loss using labels from source
        loss_fn = torch.nn.CrossEntropyLoss()
        loss = loss_fn(logits.view(-1, logits.size(-1)), labels_source.view(-1))

        # Add boundary loss
        mask_weight = 1.5
        boundary_loss = mask_weight * subspace_proj_a.intervention_boundaries.sum()
        loss += boundary_loss

        # Backward pass and optimization
        loss.backward()
        optimizer_a.step()
        scheduler_a.step()

        # Update temperature
        subspace_proj_a.set_temperature(temperature_schedule[step])
        step += 1

        pbar.set_postfix({'loss': loss.item()})

