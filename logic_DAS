print(f"IIA for Model B (XOR decomposed): {iia_score_b:.4f}")

if iia_score_a > iia_score_b:
    print("The model's reasoning aligns more with Causal Model A (XOR as unitary operation).")
elif iia_score_b > iia_score_a:
    print("The model's reasoning aligns more with Causal Model B (XOR decomposed into OR, AND, NOT).")
else:
    print("The model's reasoning aligns equally with both causal models.")
