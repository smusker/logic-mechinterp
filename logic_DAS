###############################################################################
# BOUNDLESS DAS SETUP: GENERATING INTERVENTION PAIRS
###############################################################################

def build_intervention_pair(cfunc):
    c1 = random.choice(colors)
    s1 = random.choice(shapes)
    c2 = random.choice(colors)
    s2 = random.choice(shapes)
    while (c2 == c1 and s2 == s1):
        c2 = random.choice(colors)
        s2 = random.choice(shapes)

    label1 = "True" if cfunc(c1, s1) else "False"
    label2 = "True" if cfunc(c2, s2) else "False"

    def to_prompt_and_target(cc, ss, ll):
        intro = (
            "We will use 'yel' for yellow, 'blu' for blue, 'grn' for green.\n"
            "We will use 'cir' for circle, 'tri' for triangle, 'rec' for rectangle.\n\n"
            "Learn the secret rule to label the objects correctly. "
            "If an object follows the rule, it should be labeled 'True'. Otherwise, 'False'.\n\n"
            "Label this object:\n"
        )
        obj_line = f"- {color_abbr[cc]} {shape_abbr[ss]}"
        full_prompt = intro + obj_line + "\n"
        full_target = f"{obj_line} -> {ll}\n"
        enc_p = tokenizer(full_prompt, return_tensors="pt")
        enc_t = tokenizer(full_target, return_tensors="pt")
        in_ids = torch.cat([enc_p["input_ids"], enc_t["input_ids"]], dim=1).squeeze(0)
        attn = torch.ones_like(in_ids)
        lab = in_ids.clone()
        lab[: enc_p["input_ids"].size(1)] = -100
        return in_ids, attn, lab

    ib, ab, lb = to_prompt_and_target(c1, s1, label1)
    isrc, asrc, lsrc = to_prompt_and_target(c1, s1, label2)
    return {
        "input_ids_base": ib,
        "attn_base": ab,
        "labels_base": lb,
        "input_ids_source": isrc,
        "attn_source": asrc,
        "labels_source": lsrc
    }

def prep_intervention_data(cmodel_func, n=10000):
    store = []
    for _ in tqdm(range(n), desc="Building intervention data"):
        ex = build_intervention_pair(cmodel_func)
        store.append(ex)
    # Pad
    maxl = 0
    for e in store:
        maxl = max(maxl, e["input_ids_base"].size(0), e["input_ids_source"].size(0))
    for e in store:
        e["input_ids_base"] = pad_seq(e["input_ids_base"], maxl, tokenizer.pad_token_id)
        e["attn_base"] = pad_seq(e["attn_base"], maxl, 0)
        e["labels_base"] = pad_seq(e["labels_base"], maxl, -100, label_pad=-100)
        e["input_ids_source"] = pad_seq(e["input_ids_source"], maxl, tokenizer.pad_token_id)
        e["attn_source"] = pad_seq(e["attn_source"], maxl, 0)
        e["labels_source"] = pad_seq(e["labels_source"], maxl, -100, label_pad=-100)
    ds = Dataset.from_dict({
        "input_ids_base": [x["input_ids_base"].tolist() for x in store],
        "attn_base": [x["attn_base"].tolist() for x in store],
        "labels_base": [x["labels_base"].tolist() for x in store],
        "input_ids_source": [x["input_ids_source"].tolist() for x in store],
        "attn_source": [x["attn_source"].tolist() for x in store],
        "labels_source": [x["labels_source"].tolist() for x in store]
    })
    ds.set_format(type="torch", columns=[
        "input_ids_base","attn_base","labels_base",
        "input_ids_source","attn_source","labels_source"
    ])
    loader = DataLoader(ds, batch_size=8)
    return loader

loader_a = prep_intervention_data(causal_model_a, n=10000)
loader_b = prep_intervention_data(causal_model_b, n=10000)

for param in model.parameters():
    param.requires_grad = False

###############################################################################
# TRAINING BOUNDLESS DAS FOR Causal Model A
###############################################################################

layers_to_intervene = [0, 5, 10, 15, 20, 25, 30]
epochs = 2
subspace_proj_a = BoundlessRotatedSpaceIntervention(embed_dim=model.config.hidden_size).to(device)
opt_a = torch.optim.Adam([
    {"params": subspace_proj_a.rotate_layer.parameters()},
    {"params": subspace_proj_a.intervention_boundaries, "lr":1e-2}],
    lr=1e-3
)

total_steps_a = len(loader_a)*epochs
scheduler_a = torch.optim.lr_scheduler.LinearLR(opt_a, start_factor=1.0, end_factor=0.0, total_iters=total_steps_a)
temp_start, temp_end = 50.0, 0.1
temp_schedule_a = torch.linspace(temp_start, temp_end, total_steps_a)

step_count = 0
subspace_proj_a.train()
for ep in range(epochs):
    pbar = tqdm(loader_a, desc=f"Boundless DAS (Model A) Epoch {ep+1}/{epochs}")
    for batch in pbar:
        opt_a.zero_grad()
        inb = batch["input_ids_base"].to(device)
        ab = batch["attn_base"].to(device)
        lbsrc = batch["labels_source"].to(device)
        insrc = batch["input_ids_source"].to(device)
        asrc = batch["attn_source"].to(device)
        with torch.no_grad():
            outb = model(inb, attention_mask=ab, output_hidden_states=True)
            outs = model(insrc, attention_mask=asrc, output_hidden_states=True)
        hidden_b = list(outb.hidden_states)
        hidden_s = list(outs.hidden_states)
        mixed = list(hidden_b)
        for lay in layers_to_intervene:
            hb = hidden_b[lay]
            hs = hidden_s[lay]
            hb_clone = hb.clone()
            for bidx in range(hb.size(0)):
                for tidx in range(hb.size(1)):
                    hb_clone[bidx, tidx, :] = subspace_proj_a(hb[bidx,tidx,:], hs[bidx,tidx,:].detach())
            mixed[lay] = hb_clone

        # Forward from the lowest intervened layer
        hidden_states = mixed[layers_to_intervene[0]]
        for li in range(layers_to_intervene[0]+1, len(hidden_b)):
            if li in layers_to_intervene:
                hidden_states = mixed[li]
            else:
                hidden_states = model.model.layers[li](hidden_states)[0]
        logits = model.lm_head(hidden_states)
        lossfn = torch.nn.CrossEntropyLoss()
        loss = lossfn(logits.view(-1, logits.size(-1)), lbsrc.view(-1))

        # boundary loss
        mask_weight=1.5
        boundary_loss = mask_weight*subspace_proj_a.intervention_boundaries.sum()
        loss += boundary_loss

        loss.backward()
        opt_a.step()
        scheduler_a.step()
        subspace_proj_a.set_temperature(temp_schedule_a[step_count])
        step_count+=1
        pbar.set_postfix({"loss": loss.item()})

