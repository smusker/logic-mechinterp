def evaluate_iia(loader, subspace_proj):
    model.eval()
    subspace_proj.eval()
    total_tok = 0
    correct_tok = 0
    with torch.no_grad():
        for batch in loader:
            inb = batch["input_ids_base"].to(device)
            ab = batch["attn_base"].to(device)
            lbsrc = batch["labels_source"].to(device)
            insrc = batch["input_ids_source"].to(device)
            asrc = batch["attn_source"].to(device)
            outb = model(inb, attention_mask=ab, output_hidden_states=True)
            outs = model(insrc, attention_mask=asrc, output_hidden_states=True)
            hb = list(outb.hidden_states)
            hs = list(outs.hidden_states)
            mixed = list(hb)
            for lay in layers_to_intervene:
                hbc = hb[lay].clone()
                for bidx in range(hbc.size(0)):
                    for tidx in range(hbc.size(1)):
                        hbc[bidx, tidx, :] = subspace_proj(hb[lay][bidx,tidx,:], hs[lay][bidx,tidx,:])
                mixed[lay] = hbc
            hidden_states = mixed[layers_to_intervene[0]]
            for li in range(layers_to_intervene[0]+1, len(hb)):
                if li in layers_to_intervene:
                    hidden_states = mixed[li]
                else:
                    hidden_states = model.model.layers[li](hidden_states)[0]
            logits = model.lm_head(hidden_states)
            preds = torch.argmax(logits, dim=-1)
            mask = (lblsrc != -100)
            total_tok += mask.sum().item()
            correct_tok += ((preds == lbsrc) & mask).sum().item()
    return correct_tok / total_tok

score_a = evaluate_iia(loader_a, subspace_proj_a)
score_b = evaluate_iia(loader_b, subspace_proj_b)

print("\n--- Interchange Intervention Accuracy Comparison ---")
print(f"Model A (XOR unitary) IIA: {score_a:.4f}")
print(f"Model B (XOR decomposed) IIA: {score_b:.4f}")
if score_a > score_b:
    print("The model's internal reasoning aligns more with Model A.")
elif score_b > score_a:
    print("The model's internal reasoning aligns more with Model B.")
else:
    print("Both causal models yield the same IIA.")
