import math

num_layers = model.config.num_hidden_layers
max_tokens = 128
layer_step = 3
token_step = 8
coflip_map_a = np.zeros((math.ceil(num_layers/layer_step), math.ceil(max_tokens/token_step)))
catflip_map_a = np.zeros_like(coflip_map_a)

subspace_proj_a.eval()
def swap_and_check_a(inb, ab, insrc, asrc, lbsrc, layer_win, token_win):
    with torch.no_grad():
        outb = model(inb, attention_mask=ab, output_hidden_states=True)
        outs = model(insrc, attention_mask=asrc, output_hidden_states=True)
    hidden_b = list(outb.hidden_states)
    hidden_s = list(outs.hidden_states)
    mixed = list(hidden_b)
    ls, le = layer_win
    ts, te = token_win
    for lay in range(ls, le):
        hb = hidden_b[lay].clone()
        hs = hidden_s[lay]
        max_toks = min(hb.size(1), te)
        for bidx in range(hb.size(0)):
            for tidx in range(ts, max_toks):
                hb[bidx, tidx, :] = subspace_proj_a(hidden_b[lay][bidx,tidx,:], hs[bidx,tidx,:])
        mixed[lay] = hb
    hidden_states = mixed[ls]
    for li in range(ls+1, len(hidden_b)):
        if ls <= li < le:
            hidden_states = mixed[li]
        else:
            hidden_states = model.model.layers[li](hidden_states)[0]
    logits = model.lm_head(hidden_states)
    preds = torch.argmax(logits, dim=-1)
    mask = (lbsrc != -100)
    cat_flips = (preds != lbsrc) & mask
    cat_flip_count = cat_flips.sum().item()
    tok_count = mask.sum().item()
    return cat_flip_count, tok_count

layers_list = [(i, min(i+layer_step, num_layers)) for i in range(0,num_layers,layer_step)]
tokens_list = [(i, min(i+token_step, max_tokens)) for i in range(0,max_tokens,token_step)]

total_evals = 200
eval_batches = 0
with torch.no_grad():
    for batch in tqdm(loader_a, desc="Eval IIA Heatmap A"):
        inb = batch["input_ids_base"].to(device)
        ab = batch["attn_base"].to(device)
        insrc = batch["input_ids_source"].to(device)
        asrc = batch["attn_source"].to(device)
        lbsrc = batch["labels_source"].to(device)
        bs = inb.size(0)
        if eval_batches*bs > total_evals:
            break
        eval_batches += 1
        for li, (ls, le) in enumerate(layers_list):
            for ti, (ts, te) in enumerate(tokens_list):
                catflip, tcount = swap_and_check_a(inb, ab, insrc, asrc, lbsrc, (ls, le), (ts, te))
                catflip_map_a[li, ti] += catflip
                coflip_map_a[li, ti]  += tcount

heatmap_a = np.true_divide(catflip_map_a, coflip_map_a, out=np.zeros_like(catflip_map_a), where=(coflip_map_a!=0))

plt.figure(figsize=(10,6))
plt.imshow(heatmap_a, aspect='auto', cmap='viridis', origin='upper')
plt.colorbar(label='Proportion of changed tokens w.r.t. source label')
plt.xticks(range(len(tokens_list)), [f"{x[0]}-{x[1]}" for x in tokens_list], rotation=45, fontsize=7)
plt.yticks(range(len(layers_list)), [f"{x[0]}-{x[1]}" for x in layers_list], fontsize=7)
plt.title("Model A: IIA Heatmap (cat flips)")
plt.xlabel("Token windows")
plt.ylabel("Layer windows")
os.makedirs("heatmaps", exist_ok=True)
plt.savefig("heatmaps/modelA_iia_heatmap.png", dpi=150, bbox_inches='tight')
plt.close()

